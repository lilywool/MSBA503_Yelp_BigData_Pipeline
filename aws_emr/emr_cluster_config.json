{
  "Name": "yelp-review-intelligence-emr",
  "ReleaseLabel": "emr-7.13.0",
  "Applications": [
    { "Name": "Spark" }
  ],
  "Configurations": [
    {
      "Classification": "spark-hive-site",
      "Properties": {
        "hive.metastore.client.factory.class": "com.amazonaws.glue.catalog.metastore.AWSGlueDataCatalogHiveClientFactory"
      }
    },
    {
      "Classification": "spark-defaults",
      "Properties": {
        "spark.sql.shuffle.partitions": "192"
      }
    },
    {
      "Classification": "spark-env",
      "Configurations": [
        {
          "Classification": "export",
          "Properties": {
            "PYSPARK_PYTHON": "/usr/bin/python3.11",
            "PYSPARK_DRIVER_PYTHON": "/usr/bin/python3.11"
          }
        }
      ],
      "Properties": {}
    }
  ],
  "Instances": {
    "InstanceGroups": [
      {
        "Name": "Driver",
        "InstanceRole": "MASTER",
        "InstanceType": "REPLACE_WITH_DRIVER_INSTANCE_TYPE",
        "InstanceCount": 1
      },
      {
        "Name": "Workers",
        "InstanceRole": "CORE",
        "InstanceType": "REPLACE_WITH_WORKER_INSTANCE_TYPE",
        "InstanceCount": 2
      }
    ],
    "Ec2SubnetId": "REPLACE_WITH_YOUR_SUBNET_ID",
    "KeepJobFlowAliveWhenNoSteps": false
  },
  "BootstrapActions": [
    {
      "Name": "install-pinned-yelp-python-runtime",
      "ScriptBootstrapAction": {
        "Path": "s3://REPLACE_WITH_YOUR_BUCKET/yelp/bootstrap/bootstrap.sh"
      }
    }
  ],
  "Steps": [
    {
      "Name": "stage-yelp-bronze-parquet",
      "ActionOnFailure": "TERMINATE_CLUSTER",
      "HadoopJarStep": {
        "Jar": "command-runner.jar",
        "Args": [
          "spark-submit",
          "s3://REPLACE_WITH_YOUR_BUCKET/yelp/pipeline/bronze_json_to_parquet.py",
          "--datasets", "review", "business", "checkin", "tip", "user",
          "--input-root", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/raw/",
          "--output-root", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/bronze-source/",
          "--review-partitions", "192",
          "--business-partitions", "8",
          "--checkin-partitions", "8",
          "--tip-partitions", "16",
          "--user-partitions", "32"
        ]
      }
    },
    {
      "Name": "bronze-to-silver-yelp",
      "ActionOnFailure": "TERMINATE_CLUSTER",
      "HadoopJarStep": {
        "Jar": "command-runner.jar",
        "Args": [
          "spark-submit",
          "--py-files", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/pipeline/pipeline_modules.zip",
          "s3://REPLACE_WITH_YOUR_BUCKET/yelp/tasks/bronze_to_silver.py",
          "--input-root", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/bronze-source/",
          "--output-root", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/lakehouse/",
          "--audit-log", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/audit/",
          "--lexicons-dir", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/lexicons/",
          "--database", "yelp",
          "--table-prefix", "yelp",
          "--mode", "overwrite",
          "--partitions", "192",
          "--arrow-batch-size", "5000",
          "--nlp-component", "linguistic",
          "--nlp-component", "vader",
          "--nlp-component", "nrc-emotion",
          "--nlp-component", "vad",
          "--nlp-component", "entities",
          "--nlp-component", "grammar",
          "--nlp-component", "domain-lexicons",
          "--nlp-component", "time-weighting"
        ]
      }
    },
    {
      "Name": "silver-to-gold-yelp",
      "ActionOnFailure": "TERMINATE_CLUSTER",
      "HadoopJarStep": {
        "Jar": "command-runner.jar",
        "Args": [
          "spark-submit",
          "--py-files", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/pipeline/pipeline_modules.zip",
          "s3://REPLACE_WITH_YOUR_BUCKET/yelp/tasks/silver_to_gold.py",
          "--database", "yelp",
          "--table-prefix", "yelp",
          "--input-table", "yelp.yelp_silver_reviews",
          "--output-table", "yelp.yelp_gold_dashboard_variant",
          "--output-path", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/lakehouse/gold/dashboard_variant/",
          "--audit-log", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/audit/",
          "--gold-level", "brand-sample",
          "--brand", "Chipotle",
          "--brand", "Great Clips",
          "--gold-sample-size", "5000",
          "--gold-sample-seed", "222"
        ]
      }
    },
    {
      "Name": "data-science-dashboard-yelp",
      "ActionOnFailure": "TERMINATE_CLUSTER",
      "HadoopJarStep": {
        "Jar": "command-runner.jar",
        "Args": [
          "spark-submit",
          "--py-files", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/pipeline/pipeline_modules.zip",
          "s3://REPLACE_WITH_YOUR_BUCKET/yelp/tasks/data_science_dashboard.py",
          "--database", "yelp",
          "--table-prefix", "yelp",
          "--gold-table", "yelp.yelp_gold_dashboard_variant",
          "--output-root", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/lakehouse/dashboard/",
          "--audit-log", "s3://REPLACE_WITH_YOUR_BUCKET/yelp/audit/"
        ]
      }
    }
  ],
  "LogUri": "s3://REPLACE_WITH_YOUR_BUCKET/yelp/emr-logs/",
  "JobFlowRole": "REPLACE_WITH_EMR_EC2_INSTANCE_PROFILE",
  "ServiceRole": "REPLACE_WITH_EMR_SERVICE_ROLE",
  "Tags": [
    { "Key": "project", "Value": "yelp-review-intelligence" },
    { "Key": "architecture", "Value": "bronze-silver-gold-dashboard" },
    { "Key": "lifecycle", "Value": "transient" }
  ]
}
